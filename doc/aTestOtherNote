class Solution {
  Node root;
  
    static class Node{
        int val;
        Node left;
        Node right;   
        public Node(int i) {
            val = i;
        }
    
    }
  
    public Node insertArray(int[] array, Node root, int i){
          if(i<array.length){
              if(array[i]==0){
                root = null;
              }else{
                Node temp = new Node(array[i]);
                root = temp;
            
                root.left = insertArray(array, root.left, 2*i+1);
                root.right = insertArray(array, root.right, 2*i+2);
              }
          }
        return root;
        
    }
  
    public void inOrder(Node root){
        if(root!=null){
          inOrder(root.left);
          System.out.println(root.val);
          inOrder(root.right);
        }
    }
    public static void leaves(Node root) {
      if(root == null)
        return;
      leaves(root.left);
      if(root.left == null && root.right == null){
        System.out.println(root.val);
      }
      leaves(root.right);
    }
      public static void main(String[] args){
    
        Solution t2 = new Solution();
        int array[] = {11, 0, 22, 0, 0, 33, 34};
        t2.root = t2.insertArray(array, t2.root, 0);
        t2.inOrder(t2.root);
        t2.leaves(t2.root);
    }
  
